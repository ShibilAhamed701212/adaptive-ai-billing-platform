# Environment Configuration for Adaptive Billing Platform
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (use 127.0.0.1 instead of localhost to avoid Node 20 IPv6 issues)
# REQUIRED in production. Development falls back to an in-memory database with demo data;
# production never does, and never creates demo accounts.
# Must be a replica set (MongoDB Atlas always is): sales and payments use transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive_billing

# Security & Auth
# REQUIRED in production (the server refuses to start without it). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_unique_32_plus_character_secret
JWT_EXPIRES_IN=7d

# Email (password reset links and invoice emails). Without SMTP, production cannot send reset links.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional sender, e.g. "Acme Billing <billing@acme.com>" (defaults to SMTP_USER)
SMTP_FROM=

# AI Orchestration (Optional LLM Key, Fallback is Smart Deterministic Agent)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend (used by Vite dev server proxy)
# VITE_API_URL=http://localhost:5000
