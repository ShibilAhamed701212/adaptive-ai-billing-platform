# Environment Configuration for Adaptive Billing Platform
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/adaptive_billing
REDIS_URL=redis://localhost:6379

# Security & Auth
JWT_SECRET=replace_with_a_unique_32_plus_character_secret
JWT_EXPIRES_IN=7d

# AI Orchestration (Optional LLM Key, Fallback is Smart Deterministic Agent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Storage (Local / S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
