# Environment Configuration for Adaptive Billing Platform
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (use 127.0.0.1 instead of localhost to avoid Node 20 IPv6 issues)
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive_billing

# Security & Auth
JWT_SECRET=replace_with_a_unique_32_plus_character_secret
JWT_EXPIRES_IN=7d

# AI Orchestration (Optional LLM Key, Fallback is Smart Deterministic Agent)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend (used by Vite dev server proxy)
# VITE_API_URL=http://localhost:5000
